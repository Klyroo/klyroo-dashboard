@namespace Lux.Dashboard
@using System.Globalization
@inherits LxComponentBase

<LxDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Items is not { Count: > 0 })" Skeleton="DashboardSkeletonKind.Stats"
                 Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-slot="dashboard-stats" data-variant="@Variant">
        @if (Items is not null)
        {
            @foreach (var item in Items)
            {
                <div class="flex flex-col gap-1 @(string.Equals(Variant, "tiles", StringComparison.OrdinalIgnoreCase) ? "rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg-muted) p-3" : "")"
                     data-slot="dashboard-stats-item" data-key="@item.Key">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-medium text-(--lux-text-muted)">@item.Label</span>
                        @if (item.Status is not null)
                        {
                            <LxBadge Label="@item.Status.Label" Color="@(item.Status.Color is not null ? new LxColor(item.Status.Color) : LxColor.Neutral)" Variant="LxVariant.Subtle" Size="LxSize.Sm" />
                        }
                    </div>
                    <div class="flex items-baseline justify-between gap-2">
                        <span class="text-xl font-bold tabular-nums text-(--lux-text-highlighted)" data-slot="dashboard-stats-value">
                            @(item.Value.HasValue ? DashboardFormat.Format(item.Value, item.Format, FormatCulture) : "–")
                        </span>
                        @if (item.Delta is { } d)
                        {
                            var good = item.InvertDelta ? d < 0 : d > 0;
                            <span class="text-xs font-semibold tabular-nums @(good ? "text-(--lux-success-text)" : "text-(--lux-error-text)")"
                                  data-slot="dashboard-stats-delta">
                                @DashboardFormat.Format(d, DashboardFormatPreset.Delta, FormatCulture)
                            </span>
                        }
                    </div>
                    @if (item.Progress is { } prog)
                    {
                        var pct = Math.Clamp(prog, 0, 100);
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-(--lux-bg-muted)"
                             role="progressbar" aria-label="@item.Label"
                             aria-valuenow="@Math.Round(pct)" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full bg-(--lux-primary)" style="@($"width:{pct.ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(item.Caption))
                    {
                        <span class="text-xs text-(--lux-text-muted)">@item.Caption</span>
                    }
                </div>
            }
        }
    </div>
</LxDashboardCard>

@code {
    [Parameter] public IDashboardSource? Source { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public IReadOnlyList<DashboardStatsItem>? Items { get; set; }
    [Parameter] public string Variant { get; set; } = "plain";
    [Parameter] public int Span { get; set; } = 12;
    [Parameter] public bool Card { get; set; } = true;
    [Parameter] public bool? Menu { get; set; }
    [Parameter] public bool? Freshness { get; set; }

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("label", "Label"),
            new("value", "Value", Numeric: true),
            new("change", "Change", Numeric: true),
        };
        var rows = (Items ?? []).Select(i => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
        {
            ["label"] = i.Label,
            ["value"] = DashboardFormat.Format(i.Value, i.Format, FormatCulture),
            ["change"] = i.Delta.HasValue ? DashboardFormat.Format(i.Delta, DashboardFormatPreset.Delta, FormatCulture) : null,
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }
}
