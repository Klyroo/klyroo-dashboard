@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Rows is not { Count: > 0 })" Skeleton="DashboardSkeletonKind.Table"
                 Menu="@Menu" Freshness="@Freshness" ViewAsTable="false" Tabulate="BuildDataTable" Class="@Class">
    <div class="overflow-x-auto" data-slot="dashboard-table">
        <table class="min-w-full text-xs">
            <thead class="border-b border-(--klyroo-border) font-semibold text-(--klyroo-text-muted)">
                <tr>
                    @if (Columns is not null)
                    {
                        @foreach (var col in Columns)
                        {
                            var isNum = col.Type is "number" or "delta" or "percent" or "bar";
                            var ariaSort = Sort?.Key == col.Key
                                ? (Sort.Descending ? "descending" : "ascending")
                                : (col.Sortable ? "none" : null);
                            <th scope="col"
                                aria-sort="@ariaSort"
                                class="px-3 py-2 @(isNum ? "text-end" : "text-start")"
                                data-slot="dashboard-table-header"
                                data-key="@col.Key">
                                @if (col.Sortable)
                                {
                                    <button type="button"
                                            class="inline-flex items-center gap-1 font-semibold hover:text-(--klyroo-text-highlighted)"
                                            data-slot="dashboard-table-sort"
                                            @onclick="@(() => CycleSortAsync(col))">
                                        <span>@col.Label</span>
                                        @if (Sort?.Key == col.Key)
                                        {
                                            <span aria-hidden="true">@(Sort.Descending ? "↓" : "↑")</span>
                                        }
                                    </button>
                                }
                                else
                                {
                                    @col.Label
                                }
                            </th>
                        }
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-(--klyroo-border)">
                @foreach (var row in SortedAndLimitedRows)
                {
                    var current = row;
                    var clickable = OnRowClick.HasDelegate;
                    @* The whole row takes a click of the pointer; the button in its first cell is what the keyboard and a screen reader reach. *@
                    <tr class="@(clickable ? "cursor-pointer hover:bg-(--klyroo-bg-muted)/50" : null)"
                        data-slot="dashboard-table-row"
                        @onclick="RowClick(current)">
                        @if (Columns is not null)
                        {
                            @for (var c = 0; c < Columns.Count; c++)
                            {
                                var col = Columns[c];
                                row.TryGetValue(col.Key, out var raw);
                                var isNum = col.Type is "number" or "delta" or "percent" or "bar";
                                <td class="px-3 py-2 @(isNum ? "text-end tabular-nums" : "text-start")" data-slot="dashboard-table-cell" data-type="@col.Type">
                                    @if (clickable && c == 0)
                                    {
                                        <button type="button"
                                                class="rounded-(--klyroo-radius) text-inherit hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--klyroo-primary-text)"
                                                data-slot="dashboard-table-row-button"
                                                @onclick="@(() => OnRowClick.InvokeAsync(current))"
                                                @onclick:stopPropagation="true">
                                            @RenderCell(col, raw)
                                        </button>
                                    }
                                    else
                                    {
                                        @RenderCell(col, raw)
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</KlyDashboardCard>

@code {
    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The column definitions, in display order.</summary>
    [Parameter] public IReadOnlyList<DashboardTableColumn>? Columns { get; set; }
    /// <summary>The rows: one dictionary per row, holding the raw value of each column by key. Missing and <see langword="null"/> cells show the missing-value placeholder.</summary>
    [Parameter] public IReadOnlyList<IReadOnlyDictionary<string, object?>>? Rows { get; set; }
    /// <summary>The active sort. The table updates it itself when a header is clicked, and <see cref="SortChanged"/> reports the change. Numeric columns sort descending first, then ascending, then unsorted. Empty cells always come last.</summary>
    [Parameter] public DashboardTableSort? Sort { get; set; }
    /// <summary>Raised when the sort changes, with <see langword="null"/> when the sort is cleared.</summary>
    [Parameter] public EventCallback<DashboardTableSort?> SortChanged { get; set; }
    /// <summary>Called with the row (the dictionary from <see cref="Rows"/>) when the user picks it. The first cell of each row is then a button, so the choice works with the keyboard and with a screen reader, and a click anywhere on the row does the same for the pointer. Use it to drill down, for example by setting a filter of the <c>DashboardController</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnRowClick { get; set; }
    /// <summary>The maximum number of rows shown, applied after sorting. The CSV export holds the same rows.</summary>
    [Parameter] public int? Limit { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 12.</summary>
    [Parameter] public int Span { get; set; } = 12;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    // Without a handler the row gets no click binding at all.
    private EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> RowClick(IReadOnlyDictionary<string, object?> row) =>
        OnRowClick.HasDelegate ? EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => OnRowClick.InvokeAsync(row)) : default;

    private IReadOnlyList<IReadOnlyDictionary<string, object?>> SortedRows
    {
        get
        {
            if (Rows is not { Count: > 0 }) return [];
            if (Sort is null || Columns is null) return Rows;
            var col = Columns.FirstOrDefault(c => c.Key == Sort.Key);
            if (col is null) return Rows;
            var isNumeric = col.Type is "number" or "delta" or "percent" or "bar";

            var nonNull = new List<IReadOnlyDictionary<string, object?>>();
            var nulls = new List<IReadOnlyDictionary<string, object?>>();
            foreach (var r in Rows)
            {
                if (!r.TryGetValue(col.Key, out var val) || val is null) nulls.Add(r);
                else nonNull.Add(r);
            }

            nonNull.Sort((a, b) =>
            {
                a.TryGetValue(col.Key, out var va);
                b.TryGetValue(col.Key, out var vb);
                int cmp;
                if (isNumeric && TryToDouble(va, out var da) && TryToDouble(vb, out var db))
                {
                    cmp = da.CompareTo(db);
                }
                else
                {
                    cmp = string.Compare(va?.ToString(), vb?.ToString(), StringComparison.OrdinalIgnoreCase);
                }
                return Sort.Descending ? -cmp : cmp;
            });

            nonNull.AddRange(nulls);
            return nonNull;
        }
    }

    private IReadOnlyList<IReadOnlyDictionary<string, object?>> SortedAndLimitedRows =>
        Limit is > 0 ? SortedRows.Take(Limit.Value).ToList() : SortedRows;

    private async Task CycleSortAsync(DashboardTableColumn col)
    {
        var naturalDesc = col.Type is "number" or "delta" or "percent" or "bar";
        if (Sort?.Key != col.Key)
        {
            Sort = new DashboardTableSort(col.Key, naturalDesc);
        }
        else if (Sort.Descending == naturalDesc)
        {
            Sort = new DashboardTableSort(col.Key, !naturalDesc);
        }
        else
        {
            Sort = null;
        }
        await SortChanged.InvokeAsync(Sort);
    }

    private RenderFragment RenderCell(DashboardTableColumn col, object? raw)
    {
        if (raw is null) return @<span class="text-(--klyroo-text-dimmed)">@DashboardFormat.MissingValue</span>;
        if (TryToDouble(raw, out var num))
        {
            if (col.Type == "delta")
            {
                var good = col.InvertDelta ? num < 0 : num > 0;
                var tone = DashboardDelta.IsZero(num) ? "text-(--klyroo-text-muted)" : good ? "text-(--klyroo-success-text)" : "text-(--klyroo-error-text)";
                return @<span class="font-semibold @tone">
                    @DashboardFormat.Format(num, DashboardFormatPreset.Delta, FormatCulture)
                </span>;
            }
            if (col.Type == "percent")
            {
                return @<span>@DashboardFormat.Format(num, DashboardFormatPreset.Percent, FormatCulture)</span>;
            }
            if (col.Type == "bar")
            {
                // The scale includes zero: a zero has no bar and a negative value extends to the left of a zero line.
                var (lo, hi) = ColumnScale(col.Key);
                var (left, width) = DashboardBarGeometry.Segment(num, lo, hi);
                return @<div class="inline-flex items-center justify-end gap-2">
                    <span>@DashboardFormat.Format(num, col.Format, FormatCulture)</span>
                    <span class="relative inline-block h-1.5 w-16 overflow-hidden rounded-full bg-(--klyroo-bg-muted)">
                        <span class="absolute inset-y-0 rounded-full bg-(--klyroo-primary)" style="@($"left:{DashboardBarGeometry.Percent(left)}%;width:{DashboardBarGeometry.Percent(width)}%")"></span>
                        @if (lo < 0)
                        {
                            <span class="absolute inset-y-0 w-px bg-(--klyroo-text-muted)" style="@($"left:{DashboardBarGeometry.Percent(DashboardBarGeometry.Zero(lo, hi))}%")"></span>
                        }
                    </span>
                </div>;
            }
            if (col.Type == "number")
            {
                return @<span>@DashboardFormat.Format(num, col.Format, FormatCulture)</span>;
            }
        }
        return @<span>@raw</span>;
    }

    private (double Lo, double Hi) ColumnScale(string key)
    {
        var values = new List<double>();
        foreach (var r in Rows ?? [])
        {
            if (r.TryGetValue(key, out var v) && TryToDouble(v, out var d)) values.Add(d);
        }
        return DashboardBarGeometry.Domain(values);
    }

    private static bool IsNumeric(DashboardTableColumn col) => col.Type is "number" or "delta" or "percent" or "bar";

    private static bool TryToDouble(object? val, out double result)
    {
        switch (val)
        {
            case double d:
                result = d;
                return true;
            case int i:
                result = i;
                return true;
            case long l:
                result = l;
                return true;
            case decimal m:
                result = (double)m;
                return true;
            case float f:
                result = f;
                return true;
            default:
                return double.TryParse(val?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out result);
        }
    }

    private DashboardDataTable BuildDataTable()
    {
        var cols = (Columns ?? []).Select(c => new DashboardDataColumn(c.Key, c.Label, IsNumeric(c))).ToList();
        var rows = SortedAndLimitedRows.Select(r =>
        {
            var dict = new Dictionary<string, string?>();
            foreach (var c in Columns ?? [])
            {
                r.TryGetValue(c.Key, out var v);
                dict[c.Key] = v is not null && IsNumeric(c) && TryToDouble(v, out var d)
                    ? DashboardFormat.FormatInvariant(d)
                    : v?.ToString();
            }
            return (IReadOnlyDictionary<string, string?>)dict;
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }
}
