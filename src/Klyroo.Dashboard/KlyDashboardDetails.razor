@namespace Klyroo.Dashboard
@using Microsoft.JSInterop
@inherits KlyComponentBase
@inject IJSRuntime JS

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(VisibleItems.Count == 0)" Skeleton="DashboardSkeletonKind.Details"
                 Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <dl class="m-0 grid grid-cols-1 gap-3 sm:grid-cols-2" data-slot="dashboard-details">
        @foreach (var item in VisibleItems)
        {
            <div class="flex flex-col gap-0.5 @(item.FullSpan ? "sm:col-span-2" : "")" data-slot="dashboard-details-item" data-key="@item.Key">
                <dt class="text-xs font-medium text-(--klyroo-text-muted)">@item.Label</dt>
                <dd class="m-0 flex items-center gap-1.5 text-sm @(item.Mono ? "font-mono" : "font-medium") text-(--klyroo-text-highlighted)">
                    @if (string.IsNullOrWhiteSpace(item.Value))
                    {
                        <span class="text-(--klyroo-text-dimmed)">@DashboardFormat.MissingValue</span>
                    }
                    else if (!string.IsNullOrEmpty(item.Href))
                    {
                        <a href="@item.Href" class="text-(--klyroo-primary-text) hover:underline">@item.Value</a>
                    }
                    else
                    {
                        <span>@item.Value</span>
                    }
                    @if (item.Copy && !string.IsNullOrWhiteSpace(item.Value))
                    {
                        var toCopy = item.Value;
                        <button type="button"
                                class="inline-flex size-6 shrink-0 items-center justify-center rounded-(--klyroo-radius) text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                aria-label="@Texts.CopyValue(item.Label)"
                                title="@Texts.Copy"
                                data-slot="dashboard-details-copy"
                                @onclick="@(() => CopyToClipboardAsync(toCopy))">
                            <KlyIcon Name="copy" Class="size-3.5" />
                        </button>
                    }
                </dd>
                @if (!string.IsNullOrEmpty(item.Hint))
                {
                    <span class="text-xs text-(--klyroo-text-muted)">@item.Hint</span>
                }
            </div>
        }
    </dl>
</KlyDashboardCard>

@code {
    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The definition rows. Rows marked <c>Hidden</c> are skipped, and rows marked <c>Copy</c> get a button that copies the value with <c>navigator.clipboard.writeText</c>, which needs an interactive render mode and a secure context.</summary>
    [Parameter] public IReadOnlyList<DashboardDetailsItem>? Items { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 6.</summary>
    [Parameter] public int Span { get; set; } = 6;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private async Task CopyToClipboardAsync(string text)
    {
        if (!RendererInfo.IsInteractive) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException)
        {
            // The browser refused the clipboard (no permission or an insecure context): nothing to copy to.
        }
    }

    private IReadOnlyList<DashboardDetailsItem> VisibleItems =>
        Items?.Where(i => !i.Hidden).ToList() ?? [];

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("label", Texts.ColumnLabel),
            new("value", Texts.ColumnValue),
        };
        var rows = VisibleItems.Select(i => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
        {
            ["label"] = i.Label,
            ["value"] = i.Value,
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }
}
