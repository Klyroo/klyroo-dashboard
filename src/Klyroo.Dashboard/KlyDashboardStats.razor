@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Items is not { Count: > 0 })" Skeleton="DashboardSkeletonKind.Stats"
                 Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-slot="dashboard-stats" data-variant="@Variant">
        @if (Items is not null)
        {
            @foreach (var item in Items)
            {
                <div class="flex flex-col gap-1 @(string.Equals(Variant, "tiles", StringComparison.OrdinalIgnoreCase) ? "rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-muted) p-3" : "")"
                     data-slot="dashboard-stats-item" data-key="@item.Key">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-medium text-(--klyroo-text-muted)">@item.Label</span>
                        @if (item.Status is not null)
                        {
                            <KlyBadge Label="@item.Status.Label" Color="@(item.Status.Color is not null ? new KlyColor(item.Status.Color) : KlyColor.Neutral)" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
                        }
                    </div>
                    <div class="flex items-baseline justify-between gap-2">
                        <span class="text-xl font-bold tabular-nums text-(--klyroo-text-highlighted)" data-slot="dashboard-stats-value">
                            @DashboardFormat.Format(item.Value, item.Format, FormatCulture)
                        </span>
                        @if (item.Delta is { } d)
                        {
                            var good = item.InvertDelta ? d < 0 : d > 0;
                            <span class="text-xs font-semibold tabular-nums @(DashboardDelta.IsZero(d) ? "text-(--klyroo-text-muted)" : good ? "text-(--klyroo-success-text)" : "text-(--klyroo-error-text)")"
                                  data-slot="dashboard-stats-delta">
                                @DashboardFormat.Format(d, DashboardFormatPreset.Delta, FormatCulture)
                            </span>
                        }
                    </div>
                    @if (item.Progress is { } prog)
                    {
                        var pct = Math.Clamp(prog, 0, 100);
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-(--klyroo-bg-muted)"
                             role="progressbar" aria-label="@item.Label"
                             aria-valuenow="@Math.Round(pct)" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full bg-(--klyroo-primary)" style="@($"width:{pct.ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(item.Caption))
                    {
                        <span class="text-xs text-(--klyroo-text-muted)">@item.Caption</span>
                    }
                </div>
            }
        }
    </div>
</KlyDashboardCard>

@code {
    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The metrics, laid out in a grid of up to four columns.</summary>
    [Parameter] public IReadOnlyList<DashboardStatsItem>? Items { get; set; }
    /// <summary><c>plain</c> (the default) or <c>tiles</c>, which puts each metric in a bordered tile.</summary>
    [Parameter] public string Variant { get; set; } = "plain";
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 12.</summary>
    [Parameter] public int Span { get; set; } = 12;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("label", Texts.ColumnLabel),
            new("value", Texts.ColumnValue, Numeric: true),
            new("change", Texts.ColumnChangePercent, Numeric: true),
        };
        var rows = (Items ?? []).Select(i => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
        {
            ["label"] = i.Label,
            ["value"] = DashboardFormat.FormatInvariant(i.Value),
            ["change"] = DashboardFormat.FormatInvariant(i.Delta),
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }
}
