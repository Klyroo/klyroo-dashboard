@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Categories is not { Count: > 0 } || Series is not { Count: > 0 })"
                 Skeleton="@(ChartType == "donut" ? DashboardSkeletonKind.Donut : ChartType is "line" or "area" ? DashboardSkeletonKind.Lines : DashboardSkeletonKind.Bars)"
                 Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="flex flex-col gap-3" data-slot="dashboard-chart" data-type="@ChartType">
        @if (Categories is { Count: > 0 } && Series is { Count: > 0 })
        {
            @if (UsesCompactDrawing)
            {
                @RenderCompact(Categories, Series)
            }
            else
            {
                @RenderChart(Categories, Series)
            }

            @* KlyChart reports the pick of a bar, point or slice itself; only the compact drawing, which KlyChart does not draw, keeps a group of buttons. *@
            @if (OnSelect.HasDelegate && UsesCompactDrawing)
            {
                @RenderSelection(Categories, Series)
            }

            @if (!string.IsNullOrEmpty(Totals))
            {
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-(--klyroo-border) pt-2 text-xs" data-slot="dashboard-chart-totals">
                    @foreach (var s in Series.Where(s => !s.IsComparison))
                    {
                        // A NaN or infinite value is a gap: it is in neither the sum nor the average.
                        var finite = s.Values.Where(double.IsFinite).ToList();
                        double? totalVal = string.Equals(Totals, "average", StringComparison.OrdinalIgnoreCase)
                            ? (finite.Count > 0 ? finite.Average() : null)
                            : finite.Sum();
                        <div class="flex items-baseline gap-1.5" data-slot="dashboard-chart-total">
                            <span class="text-(--klyroo-text-muted)">@s.Label:</span>
                            <span class="font-bold tabular-nums text-(--klyroo-text-highlighted)">
                                @DashboardFormat.Format(totalVal, Format, FormatCulture)
                            </span>
                        </div>
                    }
                </div>
            }
        }
    </div>
</KlyDashboardCard>

@code {
    // Series and slice colors: the chart tokens of Klyroo.UI (--klyroo-chart-1..6, which fall back to the semantic colors), then neutral.
    private static readonly string[] Palette = ["chart-1", "chart-2", "chart-3", "chart-4", "chart-5", "chart-6", "neutral"];

    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The chart type: <c>bar</c> (the default) draws one bar per series in each category, side by side; <c>line</c> draws every series as a line; <c>area</c> draws every series as a line with the area under it filled; <c>donut</c> draws the first series that is not a comparison as a ring of slices, one per category, with the total in the middle. Any other value draws bars. The drawing is <c>KlyChart</c> of Klyroo.UI: value and category axes, gridlines, a tooltip that follows the pointer and the arrow keys, a bar or a line that starts at zero (a zero value has no bar, a negative value goes below the axis), and a data table for screen readers. In a <c>bar</c> chart, a series whose <c>Type</c> is <c>line</c> is drawn as a line over the bars, but <c>KlyChart</c> cannot mix the two, so such a chart (and a chart with <see cref="ShowLabels"/>) uses a compact drawing of its own: bars and lines from a zero baseline, without axes or gridlines, and <see cref="Stacked"/> and <see cref="Horizontal"/> do not apply. The type also picks the loading skeleton.</summary>
    [Parameter] public string Type { get; set; } = "bar";
    /// <summary>The labels of the horizontal axis, one per category, or the slices of a donut.</summary>
    [Parameter] public IReadOnlyList<string>? Categories { get; set; }
    /// <summary>The data series, all drawn (a donut draws the first one that is not a comparison) and all in the table view. Each series takes the next chart color of Klyroo.UI (<c>--klyroo-chart-1</c> to <c>--klyroo-chart-6</c>, then neutral); comparison series are muted.</summary>
    [Parameter] public IReadOnlyList<DashboardChartSeries>? Series { get; set; }
    /// <summary>How the values of labels, tooltips, totals and the table view are formatted.</summary>
    [Parameter] public DashboardFormatPreset Format { get; set; } = DashboardFormatPreset.Number;
    /// <summary>The height of the drawing in pixels at its natural width of 640. The drawing keeps its proportions and shrinks with the card, so it is shorter in a narrow one. Defaults to 220.</summary>
    [Parameter] public int Height { get; set; } = 220;
    /// <summary>Shows the legend: the series, or the slices with their value for a donut. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;
    /// <summary>Shows the formatted value above each bar (below a negative one). Lines, areas and donuts show their values in tooltips. It switches the chart to the compact drawing described at <see cref="Type"/>.</summary>
    [Parameter] public bool ShowLabels { get; set; }
    /// <summary><c>average</c> shows the average of each series, any other non-empty value shows the sum. Comparison series are left out. Nothing is shown when empty.</summary>
    [Parameter] public string? Totals { get; set; }
    /// <summary>Stacks the series of a <c>bar</c> or <c>area</c> chart instead of drawing them side by side or over one another. Comparison series are stacked too, so leave them out of a stacked chart.</summary>
    [Parameter] public bool Stacked { get; set; }
    /// <summary>Draws the bars of a <c>bar</c> chart along the horizontal axis, with the categories on the vertical one.</summary>
    [Parameter] public bool Horizontal { get; set; }
    /// <summary>Called with the category, the series key and the value when the user picks a data point. In the drawing of <c>KlyChart</c> (every chart except the compact one described at <see cref="Type"/>) the bars, points and slices themselves are the choice: a click on one, or Enter or Space on the one the arrow keys are on, with a pointer cursor and the same keyboard hint as <c>KlyChart.OnSelect</c>. A pick is reported for the series it landed on, a comparison series included (its own key and value); from the keyboard, or for a series with no value in that category, it is the first series that is not a comparison and has a value, and a category with nothing to pick is ignored. The compact drawing, which <c>KlyChart</c> cannot draw (a bar chart with a line series, or with <see cref="ShowLabels"/>), has no selectable marks, so it shows a group of buttons under the drawing instead, one per category and series (one per slice for a donut, comparison series left out), which works with the keyboard and with a screen reader too. Use it to drill down, for example by setting a filter of the <c>DashboardController</c>.</summary>
    [Parameter] public EventCallback<DashboardChartSelection> OnSelect { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 8.</summary>
    [Parameter] public int Span { get; set; } = 8;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private string ChartType =>
        string.Equals(Type, "line", StringComparison.OrdinalIgnoreCase) ? "line"
        : string.Equals(Type, "area", StringComparison.OrdinalIgnoreCase) ? "area"
        : string.Equals(Type, "donut", StringComparison.OrdinalIgnoreCase) ? "donut"
        : "bar";

    private static bool IsLineSeries(DashboardChartSeries series) =>
        string.Equals(series.Type, "line", StringComparison.OrdinalIgnoreCase);

    private bool DrawsAsLine(DashboardChartSeries series) => ChartType == "line" || IsLineSeries(series);

    // KlyChart draws one kind per chart: bars with lines over them, and value labels above bars, keep the compact drawing.
    private bool UsesCompactDrawing =>
        ChartType == "bar" && Series is { Count: > 0 } && (ShowLabels || (Series.Any(IsLineSeries) && Series.Any(s => !IsLineSeries(s))));

    private static string ColorOf(int index) => Palette[index % Palette.Length];

    // A value the list does not hold, or that is not a number, is a gap in the chart and an empty cell in the table, never a zero.
    private static double? ValueOrNull(DashboardChartSeries series, int index) =>
        index < series.Values.Count && double.IsFinite(series.Values[index]) ? series.Values[index] : null;

    private string FormatValue(double value) => DashboardFormat.Format(value, Format, FormatCulture);

    private string Percent(double value) => DashboardFormat.Format(value, DashboardFormatPreset.Percent, FormatCulture);

    private string Describe(IReadOnlyList<string> categories, IEnumerable<DashboardChartSeries> series) =>
        string.Join("; ", series.Select(s =>
            $"{s.Label}: " + string.Join(", ", categories.Select((c, i) => (Category: c, Value: ValueOrNull(s, i)))
                .Where(p => p.Value is not null).Select(p => $"{p.Category} {FormatValue(p.Value!.Value)}"))));

    private RenderFragment RenderChart(IReadOnlyList<string> categories, IReadOnlyList<DashboardChartSeries> series) => __builder =>
    {
        var donut = ChartType == "donut";
        var shown = donut ? series.Where(s => !s.IsComparison).Take(1).ToList() : series.ToList();
        if (shown.Count == 0)
        {
            return;
        }
        // A bar chart whose series are all lines is a line chart.
        var kind = ChartType switch
        {
            "line" => KlyChartType.Line,
            "area" => KlyChartType.Area,
            "donut" => KlyChartType.Donut,
            _ => shown.All(IsLineSeries) ? KlyChartType.Line : KlyChartType.Bar,
        };
        var rows = Enumerable.Range(0, categories.Count).ToList();
        var kinds = shown.Select(s => new KlyChartCategory<int>(s.Key, i => ValueOrNull(s, i)) { Label = s.Label }).ToList();
        // A comparison series is muted, the others keep the color of their position in Series. A donut colors its slices.
        var colors = donut
            ? categories.Select((_, i) => new KlyColor(ColorOf(i))).ToList()
            : shown.Select(s => s.IsComparison ? KlyColor.Neutral : new KlyColor(ColorOf(series.ToList().IndexOf(s)))).ToList();
        var total = donut ? categories.Select((_, i) => Math.Max(0, ValueOrNull(shown[0], i) ?? 0)).Sum() : 0;
        var select = OnSelect.HasDelegate ? EventCallback.Factory.Create<KlyChartSelectEventArgs<int>>(this, e => Pick(e, categories, series, shown)) : default;

        <div class="mx-auto flex w-full max-w-160 flex-col items-center" data-slot="dashboard-chart-canvas">
            <KlyChart TItem="int" Data="rows" Index="@(i => categories[i])" Categories="kinds" Type="kind"
                      Horizontal="@(Horizontal && kind == KlyChartType.Bar)"
                      Stacked="@(Stacked && kind is KlyChartType.Bar or KlyChartType.Area)"
                      Height="@(donut ? Math.Clamp(Height, 96, 240) : Height)" Width="@(donut ? Math.Clamp(Height, 96, 240) : 640)"
                      Legend="ShowLegend" Format="FormatValue" Culture="FormatCulture" Colors="colors" OnSelect="select"
                      Class="w-full" data-slot="dashboard-chart-plot">
                <Center>
                    @if (donut)
                    {
                        <div class="flex flex-col items-center justify-center text-center" data-slot="dashboard-chart-center">
                            <span class="text-xl font-bold tabular-nums text-(--klyroo-text-highlighted)" data-slot="dashboard-chart-donut-total">@FormatValue(total)</span>
                            <span class="max-w-full truncate px-4 text-[11px] text-(--klyroo-text-muted)">@shown[0].Label</span>
                        </div>
                    }
                </Center>
            </KlyChart>
        </div>
    };

    // What KlyChart reports is a row and the series the pick landed on, and that series is what is reported, a comparison series included (its own key and value).
    // Only when the series cannot be told (the keyboard) or has no value in the row, the first non-comparison series with a value stands for the category;
    // a row with nothing to pick is ignored.
    private Task Pick(KlyChartSelectEventArgs<int> e, IReadOnlyList<string> categories, IReadOnlyList<DashboardChartSeries> series, IReadOnlyList<DashboardChartSeries> shown)
    {
        if (e.Row < 0 || e.Row >= categories.Count) return Task.CompletedTask;
        var picked = e.SeriesIndex >= 0 && e.SeriesIndex < shown.Count ? shown[e.SeriesIndex] : null;
        if (picked is null || ValueOrNull(picked, e.Row) is null)
        {
            picked = series.FirstOrDefault(s => !s.IsComparison && ValueOrNull(s, e.Row) is not null);
        }
        return picked is not null && ValueOrNull(picked, e.Row) is { } value
            ? OnSelect.InvokeAsync(new DashboardChartSelection(categories[e.Row], picked.Key, value))
            : Task.CompletedTask;
    }

    // One button per data point of the compact drawing: the keyboard and a screen reader reach what the pointer reaches in the drawing.
    private RenderFragment RenderSelection(IReadOnlyList<string> categories, IReadOnlyList<DashboardChartSeries> series) => __builder =>
    {
        var donut = ChartType == "donut";
        var shown = series.Where(s => !s.IsComparison).Take(donut ? 1 : int.MaxValue).ToList();
        <div class="flex flex-wrap gap-1.5 text-xs" role="group" aria-label="@Texts.SelectPoint" data-slot="dashboard-chart-select">
            @for (var i = 0; i < categories.Count; i++)
            {
                var index = i;
                foreach (var s in shown)
                {
                    var series1 = s;
                    if (ValueOrNull(series1, index) is not { } value) continue;
                    var category = categories[index];
                    <button type="button"
                            class="inline-flex items-center gap-1 rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) px-2 py-1 text-(--klyroo-text) hover:text-(--klyroo-text-highlighted)"
                            data-slot="dashboard-chart-select-point"
                            data-category="@category" data-series="@series1.Key"
                            @onclick="@(() => OnSelect.InvokeAsync(new DashboardChartSelection(category, series1.Key, value)))">
                        <span>@(shown.Count > 1 ? $"{category} · {series1.Label}" : category)</span>
                        <span class="font-semibold tabular-nums text-(--klyroo-text-highlighted)">@FormatValue(value)</span>
                    </button>
                }
            }
        </div>
    };

    // Bars and lines together, or bars with labels: a drawing of its own on a scale that includes zero.
    private RenderFragment RenderCompact(IReadOnlyList<string> categories, IReadOnlyList<DashboardChartSeries> series) => __builder =>
    {
        var indexed = series.Select((s, i) => (Series: s, Color: ColorOf(i))).ToList();
        var bars = indexed.Where(x => !DrawsAsLine(x.Series)).ToList();
        var lines = indexed.Where(x => DrawsAsLine(x.Series)).ToList();
        var (lo, hi) = DashboardBarGeometry.Domain(series.SelectMany(s => s.Values));
        var count = categories.Count;
        var hasNegative = lo < 0;
        // Percent of the plot height from the top.
        double Y(double v) => (hi - v) / (hi - lo) * 100.0;
        var zeroY = Y(0);
        string X(int i) => DashboardBarGeometry.Percent((i + 0.5) / count * 100.0);

        if (ShowLegend)
        {
            <div class="flex flex-wrap items-center gap-3 text-xs" data-slot="dashboard-chart-legend">
                @foreach (var (s, color) in indexed)
                {
                    var isLine = DrawsAsLine(s);
                    <span class="inline-flex items-center gap-1.5" data-slot="dashboard-legend-item" data-series="@s.Key">
                        @if (s.IsComparison)
                        {
                            <span class="inline-block @(isLine ? "h-0.5 w-3 border-t-2" : "size-2.5 rounded-full border") border-dashed border-(--klyroo-text-muted)"></span>
                        }
                        else
                        {
                            <span class="inline-block @(isLine ? "h-0.5 w-3" : "size-2.5 rounded-full") bg-(--kly-color)" data-color="@color"></span>
                        }
                        <span class="text-(--klyroo-text-muted)">@s.Label</span>
                    </span>
                }
            </div>
        }

        <div class="flex flex-col gap-1 pt-2" style="@($"height:{Height}px")" data-slot="dashboard-chart-canvas">
            <div class="relative min-h-0 flex-1" role="img" aria-label="@Describe(categories, series)" data-slot="dashboard-chart-plot">
                <div class="absolute inset-x-0 @(ShowLabels && bars.Count > 0 ? "top-4" : "top-0") @(ShowLabels && hasNegative ? "bottom-4" : "bottom-0")">
                    <div class="absolute inset-x-0 border-t border-(--klyroo-border)" style="@($"top:{DashboardBarGeometry.Percent(zeroY)}%")" data-slot="dashboard-chart-baseline"></div>
                    @if (bars.Count > 0)
                    {
                        <div class="flex h-full">
                            @for (var i = 0; i < count; i++)
                            {
                                var idx = i;
                                var cat = categories[idx];
                                <div class="flex h-full min-w-0 flex-1 justify-center gap-0.5 px-1"
                                     title="@($"{cat}: {string.Join(", ", bars.Where(b => ValueOrNull(b.Series, idx) is not null).Select(b => $"{b.Series.Label} {FormatValue(ValueOrNull(b.Series, idx)!.Value)}"))}")"
                                     data-slot="dashboard-chart-column">
                                    @foreach (var (s, color) in bars)
                                    {
                                        var val = ValueOrNull(s, idx);
                                        var top = val is { } v ? Y(Math.Max(v, 0)) : zeroY;
                                        var height = val is { } w ? Math.Abs(Y(w) - zeroY) : 0;
                                        <div class="relative min-w-0 max-w-12 flex-1">
                                            <div class="absolute inset-x-0 rounded-sm @(s.IsComparison ? "bg-(--klyroo-text-muted)/50" : "bg-(--kly-color)")"
                                                 data-color="@(s.IsComparison ? null : color)"
                                                 style="@($"top:{DashboardBarGeometry.Percent(top)}%;height:{DashboardBarGeometry.Percent(height)}%")"
                                                 data-slot="dashboard-chart-bar"
                                                 data-series="@s.Key">
                                                @if (ShowLabels && val is { } labelled)
                                                {
                                                    <span class="absolute inset-x-0 @(labelled < 0 ? "top-full pt-0.5" : "bottom-full pb-0.5") whitespace-nowrap text-center text-[10px] font-semibold tabular-nums text-(--klyroo-text-muted)">
                                                        @FormatValue(labelled)
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (lines.Count > 0)
                    {
                        <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-slot="dashboard-chart-lines">
                            @foreach (var (s, color) in lines)
                            {
                                // A gap in the data breaks the line instead of drawing a zero.
                                var segments = new List<string>();
                                var run = new List<string>();
                                for (var i = 0; i < count; i++)
                                {
                                    if (ValueOrNull(s, i) is { } point)
                                    {
                                        run.Add($"{X(i)},{DashboardBarGeometry.Percent(Y(point))}");
                                    }
                                    else if (run.Count > 0)
                                    {
                                        segments.Add(string.Join(' ', run));
                                        run.Clear();
                                    }
                                }
                                if (run.Count > 0) segments.Add(string.Join(' ', run));
                                @foreach (var points in segments)
                                {
                                    <polyline fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                              vector-effect="non-scaling-stroke"
                                              stroke-dasharray="@(s.IsComparison ? "4 3" : null)"
                                              class="@(s.IsComparison ? "text-(--klyroo-text-muted)" : "text-(--kly-color)")"
                                              data-color="@(s.IsComparison ? null : color)"
                                              points="@points"
                                              data-slot="dashboard-chart-line"
                                              data-series="@s.Key" />
                                }
                            }
                        </svg>
                        @foreach (var (s, color) in lines)
                        {
                            @for (var i = 0; i < count; i++)
                            {
                                var idx = i;
                                if (ValueOrNull(s, idx) is not { } val) continue;
                                <span class="absolute size-2 rounded-full border-2 border-(--klyroo-bg) @(s.IsComparison ? "bg-(--klyroo-text-muted)" : "bg-(--kly-color)")"
                                      data-color="@(s.IsComparison ? null : color)"
                                      style="@($"left:calc({X(idx)}% - 4px);top:calc({DashboardBarGeometry.Percent(Y(val))}% - 4px)")"
                                      title="@($"{categories[idx]} · {s.Label}: {FormatValue(val)}")"
                                      data-slot="dashboard-chart-point"
                                      data-series="@s.Key"></span>
                            }
                        }
                    }
                </div>
            </div>
            <div class="flex" data-slot="dashboard-chart-labels">
                @foreach (var cat in categories)
                {
                    <span class="min-w-0 flex-1 truncate px-1 text-center text-[11px] text-(--klyroo-text-muted)" data-slot="dashboard-chart-label">@cat</span>
                }
            </div>
        </div>
    };

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn> { new("category", Texts.ColumnCategory) };
        foreach (var s in Series ?? [])
        {
            cols.Add(new DashboardDataColumn(s.Key, s.Label, Numeric: true));
        }

        var rows = new List<IReadOnlyDictionary<string, string?>>();
        var cats = Categories ?? [];
        for (var i = 0; i < cats.Count; i++)
        {
            var row = new Dictionary<string, string?> { ["category"] = cats[i] };
            foreach (var s in Series ?? [])
            {
                var v = i < s.Values.Count ? (double?)s.Values[i] : null;
                row[s.Key] = DashboardFormat.FormatInvariant(v);
            }
            rows.Add(row);
        }
        return new DashboardDataTable(cols, rows);
    }
}
