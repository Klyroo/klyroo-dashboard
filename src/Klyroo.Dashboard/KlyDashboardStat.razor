@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Label" Span="@Span" Card="@Card" Skeleton="DashboardSkeletonKind.Stat"
                 Menu="@Menu" Freshness="@Freshness" Expandable="false" Tabulate="BuildDataTable" Class="@Class">
    <HeaderRight>
        @if (Status is not null)
        {
            <KlyBadge Label="@Status.Label" Color="@(Status.Color is not null ? new KlyColor(Status.Color) : KlyColor.Neutral)" Variant="KlyVariant.Subtle" Size="KlySize.Sm" data-slot="stat-status" />
        }
    </HeaderRight>
    <ChildContent>
        <div class="flex flex-col gap-2" data-slot="dashboard-stat">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="text-2xl font-bold tabular-nums text-(--klyroo-text-highlighted)" data-slot="dashboard-stat-value">
                    @(TextValue ?? DashboardFormat.Format(Value, Format, FormatCulture))
                </span>

                @if (EffectiveDelta is { } delta && !double.IsNaN(delta))
                {
                    var isPositive = delta > 0;
                    var isGood = InvertDelta ? delta < 0 : delta > 0;
                    var toneClass = Math.Abs(delta) < 0.0001
                        ? "bg-(--klyroo-bg-muted) text-(--klyroo-text-muted)"
                        : isGood
                            ? "bg-(--klyroo-success)/15 text-(--klyroo-success-text)"
                            : "bg-(--klyroo-error)/15 text-(--klyroo-error-text)";
                    <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold tabular-nums @toneClass"
                          data-slot="dashboard-stat-delta" data-good="@(isGood ? "true" : "false")">
                        <span aria-hidden="true">@(isPositive ? "↑" : delta < 0 ? "↓" : "–")</span>
                        <span>@DashboardFormat.Format(delta, EffectiveDeltaFormat, FormatCulture)</span>
                    </span>
                }
            </div>

            @if (Trend is { Count: >= 2 })
            {
                @RenderSparkline(Trend)
            }

            @if (Goal is > 0 && Value is { } currentVal)
            {
                var pct = Math.Clamp(currentVal / Goal.Value * 100.0, 0, 100);
                <div class="flex flex-col gap-1 pt-1" data-slot="dashboard-stat-goal">
                    <div class="flex items-center justify-between text-xs text-(--klyroo-text-muted)">
                        <span>Goal @DashboardFormat.Format(Goal, Format, FormatCulture)</span>
                        <span class="font-semibold tabular-nums">@($"{Math.Round(pct)}%")</span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-(--klyroo-bg-muted)"
                         role="progressbar"
                         aria-label="@($"Goal {DashboardFormat.Format(Goal, Format, FormatCulture)}")"
                         aria-valuenow="@Math.Round(pct)"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         data-slot="dashboard-stat-goal-bar">
                        <div class="h-full @(pct >= 100 ? "bg-(--klyroo-success)" : "bg-(--klyroo-primary)")"
                             style="@($"width:{pct.ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(EffectiveCaption))
            {
                <span class="text-xs text-(--klyroo-text-muted)" data-slot="dashboard-stat-caption">@EffectiveCaption</span>
            }
        </div>
    </ChildContent>
</KlyDashboardCard>

@code {
    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The name of the metric, shown as the card title. Required.</summary>
    [Parameter] public required string Label { get; set; }
    /// <summary>The value, formatted with <see cref="Format"/>.</summary>
    [Parameter] public double? Value { get; set; }
    /// <summary>Text shown instead of the formatted <see cref="Value"/>, for values that are not numbers.</summary>
    [Parameter] public string? TextValue { get; set; }
    /// <summary>How <see cref="Value"/>, <see cref="Compare"/> and <see cref="Goal"/> are formatted.</summary>
    [Parameter] public DashboardFormatPreset Format { get; set; } = DashboardFormatPreset.Number;
    /// <summary>The change to display, in percent. It takes precedence over <see cref="Compare"/>.</summary>
    [Parameter] public double? Delta { get; set; }
    /// <summary>How the delta is formatted. Defaults to <c>Delta</c>, or to <c>Points</c> or <c>Signed</c> when <see cref="CompareMode"/> is <c>difference</c>.</summary>
    [Parameter] public DashboardFormatPreset? DeltaFormat { get; set; }
    /// <summary>When set, a negative delta is shown as good news (for churn, cost or latency).</summary>
    [Parameter] public bool InvertDelta { get; set; }
    /// <summary>The previous value. When <see cref="Delta"/> is not set, the delta is computed from it, and the default caption names it.</summary>
    [Parameter] public double? Compare { get; set; }
    /// <summary><c>change</c> (the default) computes the percent change from <see cref="Compare"/> and shows nothing when <see cref="Compare"/> is zero. <c>difference</c> uses the raw difference, multiplied by 100 for the <c>Ratio</c> format.</summary>
    [Parameter] public string CompareMode { get; set; } = "change";
    /// <summary>A line of text under the value. Replaces the default <c>vs ... previous period</c> caption.</summary>
    [Parameter] public string? Caption { get; set; }
    /// <summary>Points of a sparkline. It needs at least two values.</summary>
    [Parameter] public IReadOnlyList<double>? Trend { get; set; }
    /// <summary>A target that adds a progress bar and a percentage. It must be greater than 0.</summary>
    [Parameter] public double? Goal { get; set; }
    /// <summary>A status pill in the header.</summary>
    [Parameter] public DashboardStatus? Status { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 4.</summary>
    [Parameter] public int Span { get; set; } = 4;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private double? EffectiveDelta
    {
        get
        {
            if (Delta.HasValue) return Delta;
            if (Value is { } cur && Compare is { } prev)
            {
                if (string.Equals(CompareMode, "difference", StringComparison.OrdinalIgnoreCase))
                {
                    var scale = Format == DashboardFormatPreset.Ratio ? 100.0 : 1.0;
                    return (cur - prev) * scale;
                }
                if (Math.Abs(prev) > 0.000001)
                {
                    return (cur - prev) / Math.Abs(prev) * 100.0;
                }
            }
            return null;
        }
    }

    private DashboardFormatPreset EffectiveDeltaFormat =>
        DeltaFormat ?? (string.Equals(CompareMode, "difference", StringComparison.OrdinalIgnoreCase)
            ? (Format is DashboardFormatPreset.Percent or DashboardFormatPreset.Ratio ? DashboardFormatPreset.Points : DashboardFormatPreset.Signed)
            : DashboardFormatPreset.Delta);

    private string? EffectiveCaption =>
        !string.IsNullOrEmpty(Caption) ? Caption
        : Compare.HasValue ? $"vs {DashboardFormat.Format(Compare, Format, FormatCulture)} previous period"
        : null;

    private string ChangeLabel => EffectiveDeltaFormat switch
    {
        DashboardFormatPreset.Delta or DashboardFormatPreset.Percent => "Change (%)",
        DashboardFormatPreset.Points => "Change (pts)",
        _ => "Change",
    };

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("label", "Label"),
            new("value", "Value", Numeric: true),
        };
        var row = new Dictionary<string, string?>
        {
            ["label"] = Label,
            ["value"] = TextValue ?? DashboardFormat.FormatInvariant(Value),
        };
        if (Compare.HasValue)
        {
            cols.Add(new("previous", "Previous", Numeric: true));
            row["previous"] = DashboardFormat.FormatInvariant(Compare);
        }
        if (EffectiveDelta is { } delta && !double.IsNaN(delta))
        {
            cols.Add(new("change", ChangeLabel, Numeric: true));
            row["change"] = DashboardFormat.FormatInvariant(delta);
        }
        if (Goal is > 0)
        {
            cols.Add(new("goal", "Goal", Numeric: true));
            row["goal"] = DashboardFormat.FormatInvariant(Goal);
        }
        return new DashboardDataTable(cols, [row]);
    }

    private static RenderFragment RenderSparkline(IReadOnlyList<double> points)
    {
        var min = points.Min();
        var max = points.Max();
        var range = max - min <= 0 ? 1.0 : max - min;
        var coords = new List<string>(points.Count);
        for (var i = 0; i < points.Count; i++)
        {
            var x = (i * 100.0 / (points.Count - 1)).ToString("0.#", CultureInfo.InvariantCulture);
            var y = (28.0 - ((points[i] - min) / range * 24.0)).ToString("0.#", CultureInfo.InvariantCulture);
            coords.Add($"{x},{y}");
        }
        var line = string.Join(' ', coords);
        return @<svg viewBox="0 0 100 30" class="h-8 w-full overflow-visible text-(--klyroo-primary-text)" data-slot="dashboard-stat-sparkline" aria-hidden="true">
            <polyline fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="@line" />
        </svg>;
    }
}
