@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Items is not { Count: > 0 })"
                 Skeleton="@(IsFunnel ? DashboardSkeletonKind.Funnel : DashboardSkeletonKind.Bars)"
                 Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="flex flex-col gap-2.5" data-slot="dashboard-bars" data-variant="@Variant">
        @if (Items is { Count: > 0 })
        {
            var visible = Limit is > 0 ? Items.Take(Limit.Value).ToList() : Items;
            var maxVal = IsFunnel
                ? Math.Max(1.0, Items[0].Value)
                : Math.Max(1.0, Max ?? Items.Max(i => i.Value));

            @for (var i = 0; i < visible.Count; i++)
            {
                var idx = i;
                var item = visible[i];
                var widthPct = Math.Clamp(item.Value / maxVal * 100.0, 2, 100).ToString("0.#", CultureInfo.InvariantCulture);
                var funnelNote = IsFunnel
                    ? (i == 0 ? "base 100%" : (Items[i - 1].Value > 0 ? $"{Math.Round(item.Value / Items[i - 1].Value * 100)}% of the previous step" : DashboardFormat.MissingValue))
                    : null;

                <div class="flex flex-col gap-1" data-slot="dashboard-bar-row" data-selected="@(item.Selected ? "true" : null)">
                    <div class="flex items-baseline justify-between gap-2 text-xs">
                        <div class="flex min-w-0 items-center gap-1.5">
                            <span class="truncate font-medium text-(--klyroo-text-highlighted)">@item.Label</span>
                            @if (!string.IsNullOrEmpty(item.Tag))
                            {
                                <span class="rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) px-1.5 py-0.5 font-mono text-[10px] text-(--klyroo-text-muted)"
                                      data-slot="dashboard-bar-tag">@item.Tag</span>
                            }
                        </div>
                        <div class="flex shrink-0 items-baseline gap-2 tabular-nums">
                            @if (funnelNote is not null)
                            {
                                <span class="text-[11px] text-(--klyroo-text-muted)" data-slot="dashboard-funnel-note">@funnelNote</span>
                            }
                            <span class="font-semibold text-(--klyroo-text-highlighted)" data-slot="dashboard-bar-value">
                                @(item.Meta ?? DashboardFormat.Format(item.Value, Format, FormatCulture))
                            </span>
                        </div>
                    </div>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-(--klyroo-bg-muted)">
                        <div class="h-full rounded-full @(Emphasis == "first" && idx > 0 ? "bg-(--klyroo-text-muted)/50" : "bg-(--klyroo-primary)")"
                             style="@($"width:{widthPct}%")"
                             data-slot="dashboard-bar-fill"></div>
                    </div>
                </div>
            }
        }
    </div>
</KlyDashboardCard>

@code {
    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The bars, in display order.</summary>
    [Parameter] public IReadOnlyList<DashboardBarItem>? Items { get; set; }
    /// <summary>How the values are formatted, unless an item supplies its own <c>Meta</c> text.</summary>
    [Parameter] public DashboardFormatPreset Format { get; set; } = DashboardFormatPreset.Number;
    /// <summary>The value that fills a whole bar. Defaults to the largest item. Ignored by the funnel variant.</summary>
    [Parameter] public double? Max { get; set; }
    /// <summary>The maximum number of bars shown.</summary>
    [Parameter] public int? Limit { get; set; }
    /// <summary><c>bars</c> (the default), or <c>funnel</c>: every bar is scaled to the first one and shows its share of the previous step.</summary>
    [Parameter] public string Variant { get; set; } = "bars";
    /// <summary><c>all</c> (the default) colors every bar. <c>first</c> colors the first bar and mutes the others.</summary>
    [Parameter] public string Emphasis { get; set; } = "all";
    /// <summary>Width of the block in columns of the 12-column grid, clamped between 1 and 12. Defaults to 6.</summary>
    [Parameter] public int Span { get; set; } = 6;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. The CSV text only reaches your code through <c>KlyDashboardCard.OnCsvExported</c>, which the ready-made blocks do not expose, so Download CSV does nothing on them. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private bool IsFunnel => string.Equals(Variant, "funnel", StringComparison.OrdinalIgnoreCase);

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("label", "Label"),
            new("value", "Value", Numeric: true),
        };
        var rows = (Items ?? []).Select(i => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
        {
            ["label"] = i.Label,
            ["value"] = DashboardFormat.Format(i.Value, Format, FormatCulture),
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }
}
