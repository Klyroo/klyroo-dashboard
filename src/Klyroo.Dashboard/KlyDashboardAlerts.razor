@namespace Klyroo.Dashboard
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Items is not { Count: > 0 })" EmptyTitle="@Texts.NothingNeedsAttention"
                 Skeleton="DashboardSkeletonKind.Rows" Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="divide-y divide-(--klyroo-border)" data-slot="dashboard-alerts">
        @foreach (var item in OrderedItems)
        {
            var sevColor = item.Severity switch
            {
                DashboardAlertSeverity.Error => KlyColor.Error,
                DashboardAlertSeverity.Warning => KlyColor.Warning,
                DashboardAlertSeverity.Success => KlyColor.Success,
                _ => KlyColor.Info,
            };
            var sevLabel = SeverityLabel(item.Severity);
            <div class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0"
                 data-slot="dashboard-alert-row" data-severity="@item.Severity.ToString().ToLowerInvariant()">
                <div class="flex min-w-0 items-center gap-2.5">
                    <KlyBadge Label="@sevLabel" Color="sevColor" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
                    <div class="flex min-w-0 flex-col">
                        <span class="truncate text-xs font-semibold text-(--klyroo-text-highlighted)" data-slot="dashboard-alert-label">@item.Label</span>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <span class="truncate text-[11px] text-(--klyroo-text-muted)">@item.Description</span>
                        }
                    </div>
                </div>
                <div class="flex shrink-0 items-center gap-2 text-xs">
                    @if (!string.IsNullOrEmpty(item.Value))
                    {
                        <span class="font-semibold tabular-nums text-(--klyroo-text-highlighted)">@item.Value</span>
                    }
                    @if (!string.IsNullOrEmpty(item.ActionLabel))
                    {
                        if (!string.IsNullOrEmpty(item.ActionHref))
                        {
                            <a href="@item.ActionHref" class="font-medium text-(--klyroo-primary-text) hover:underline" data-slot="dashboard-alert-action">@item.ActionLabel</a>
                        }
                        else if (OnAction.HasDelegate)
                        {
                            <button type="button"
                                    class="rounded-(--klyroo-radius) font-medium text-(--klyroo-primary-text) hover:underline"
                                    data-slot="dashboard-alert-action"
                                    @onclick="@(() => OnAction.InvokeAsync(item))">
                                @item.ActionLabel
                            </button>
                        }
                    }
                </div>
            </div>
        }
    </div>
</KlyDashboardCard>

@code {
    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The alerts to display.</summary>
    [Parameter] public IReadOnlyList<DashboardAlertItem>? Items { get; set; }
    /// <summary><c>severity</c> (the default) puts errors first and successes last. Any other value keeps the order of <see cref="Items"/>.</summary>
    [Parameter] public string Order { get; set; } = "severity";
    /// <summary>The maximum number of alerts shown, applied after ordering. The table view and the CSV export hold the same alerts.</summary>
    [Parameter] public int? Limit { get; set; }
    /// <summary>Called with the alert when the user clicks its action. An alert with an <c>ActionLabel</c> and no <c>ActionHref</c> renders its action as a button only when this has a handler; without one the action is left out. An alert with an <c>ActionHref</c> always renders a link.</summary>
    [Parameter] public EventCallback<DashboardAlertItem> OnAction { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 6.</summary>
    [Parameter] public int Span { get; set; } = 6;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private string SeverityLabel(DashboardAlertSeverity severity) => severity switch
    {
        DashboardAlertSeverity.Error => Texts.SeverityCritical,
        DashboardAlertSeverity.Warning => Texts.SeverityWarning,
        DashboardAlertSeverity.Success => Texts.SeverityResolved,
        _ => Texts.SeverityInfo,
    };

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("severity", Texts.ColumnSeverity),
            new("label", Texts.ColumnAlert),
            new("description", Texts.ColumnDescription),
            new("value", Texts.ColumnValue),
        };
        var rows = OrderedItems.Select(i => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
        {
            ["severity"] = SeverityLabel(i.Severity),
            ["label"] = i.Label,
            ["description"] = i.Description,
            ["value"] = i.Value,
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }

    private IReadOnlyList<DashboardAlertItem> OrderedItems
    {
        get
        {
            if (Items is not { Count: > 0 }) return [];
            var sorted = string.Equals(Order, "severity", StringComparison.OrdinalIgnoreCase)
                ? Items.OrderBy(i => (int)i.Severity).ToList()
                : Items.ToList();
            return Limit is > 0 ? sorted.Take(Limit.Value).ToList() : sorted;
        }
    }
}
