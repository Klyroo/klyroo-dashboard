@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Items is not { Count: > 0 })" Skeleton="DashboardSkeletonKind.Feed"
                 Menu="@Menu" Freshness="@Freshness" Class="@Class">
    <div class="flex flex-col gap-3" data-slot="dashboard-feed">
        @{
            string? lastDayHeading = null;
            var visible = Limit is > 0 && Items is not null ? Items.Take(Limit.Value).ToList() : Items ?? [];
        }
        @foreach (var item in visible)
        {
            if (GroupByDay)
            {
                var heading = DayHeading(item.Time);
                if (heading != lastDayHeading)
                {
                    lastDayHeading = heading;
                    <div class="text-[11px] font-bold uppercase tracking-wider text-(--klyroo-text-muted)" data-slot="dashboard-feed-day">
                        @heading
                    </div>
                }
            }
            <div class="flex items-start gap-2.5" data-slot="dashboard-feed-item">
                <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-(--klyroo-bg-muted) text-[10px] font-bold text-(--klyroo-text-highlighted)">
                    @(item.AvatarText ?? "•")
                </span>
                <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                    <div class="flex items-baseline justify-between gap-2 text-xs">
                        <span class="font-medium text-(--klyroo-text-highlighted)" data-slot="dashboard-feed-label">@item.Label</span>
                        <time datetime="@item.Time.ToString("O")" title="@item.Time.ToString("u")"
                              class="shrink-0 text-[11px] text-(--klyroo-text-muted)" data-slot="dashboard-feed-time">
                            @DashboardFormat.FormatRelativeTime(item.Time, Now)
                        </time>
                    </div>
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <span class="text-xs text-(--klyroo-text-muted)">@item.Description</span>
                    }
                </div>
            </div>
        }
    </div>
</KlyDashboardCard>

@code {
    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The events, in display order. They are not sorted.</summary>
    [Parameter] public IReadOnlyList<DashboardFeedItem>? Items { get; set; }
    /// <summary>Inserts a heading (<c>Today</c>, <c>Yesterday</c> or an ISO date) when the day changes. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool GroupByDay { get; set; } = true;
    /// <summary>The reference moment for the day headings and the relative times. The current UTC time when <see langword="null"/>; set it to get deterministic output in tests.</summary>
    [Parameter] public DateTimeOffset? Now { get; set; }
    /// <summary>The maximum number of events shown.</summary>
    [Parameter] public int? Limit { get; set; }
    /// <summary>Width of the block in columns of the 12-column grid, clamped between 1 and 12. Defaults to 6.</summary>
    [Parameter] public int Span { get; set; } = 6;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. The CSV text only reaches your code through <c>KlyDashboardCard.OnCsvExported</c>, which the ready-made blocks do not expose, so Download CSV does nothing on them. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    private string DayHeading(DateTimeOffset time)
    {
        var now = (Now ?? DateTimeOffset.UtcNow).UtcDateTime.Date;
        var d = time.UtcDateTime.Date;
        if (d == now) return "Today";
        if (d == now.AddDays(-1)) return "Yesterday";
        return d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
