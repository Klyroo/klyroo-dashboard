<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Dashboard</RootNamespace>
    <PackageId>Klyroo.Dashboard</PackageId>
    <Description>Klyroo Dashboard components for Blazor Web &amp; .NET MAUI Hybrid.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;BL0007</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Dashboard.Core\Klyroo.Dashboard.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-ui\src\Klyroo.UI\Klyroo.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="ios" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="maccatalyst" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Klyroo.UI" />
  </ItemGroup>
</Project>
