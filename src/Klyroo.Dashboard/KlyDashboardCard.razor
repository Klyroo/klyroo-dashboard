@namespace Klyroo.Dashboard
@using Microsoft.JSInterop
@inherits KlyComponentBase
@inject IJSRuntime JS

@if (Phase != DashboardBlockPhase.Idle || Source?.State != DashboardResourceState.Disabled)
{
    <section class="@RootClass"
             style="@SpanStyle"
             aria-busy="@(Phase == DashboardBlockPhase.Loading || (Source?.Fetching ?? false) ? "true" : null)"
             data-slot="dashboard-card"
             data-phase="@Phase.ToString().ToLowerInvariant()"
             @attributes="AdditionalAttributes">
        @* Thin fetching progress bar *@
        @if (Source?.Fetching == true)
        {
            <div class="h-0.5 w-full animate-pulse bg-(--klyroo-primary)" data-slot="dashboard-card-progress" data-progress="true"></div>
        }

        @* Header *@
        @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle) || HeaderRight is not null || EffectiveMenu)
        {
            <header class="flex items-start justify-between gap-2 px-4 pt-4" data-slot="dashboard-card-header">
                <div class="flex min-w-0 flex-col gap-0.5">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <h3 class="m-0 truncate text-sm font-semibold text-(--klyroo-text-highlighted)" data-slot="dashboard-card-title">@Title</h3>
                    }
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="dashboard-card-subtitle">@Subtitle</p>
                    }
                </div>

                <div class="flex shrink-0 items-center gap-1.5" data-slot="dashboard-card-tools">
                    @if (HeaderRight is not null)
                    {
                        @HeaderRight
                    }
                    @if (EffectiveMenu && Phase == DashboardBlockPhase.Content)
                    {
                        @if (ViewAsTable && Tabulate is not null)
                        {
                            <button type="button"
                                    class="inline-flex h-7 items-center rounded-(--klyroo-radius) px-2 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                    aria-pressed="@(_showingTable ? "true" : "false")"
                                    data-slot="dashboard-card-table-toggle"
                                    @onclick="@(() => _showingTable = !_showingTable)">
                                @(_showingTable ? Texts.HideTable : Texts.ViewAsTable)
                            </button>
                        }
                        @if (Tabulate is not null)
                        {
                            <button type="button"
                                    class="inline-flex h-7 items-center rounded-(--klyroo-radius) px-2 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                    data-slot="dashboard-card-csv"
                                    @onclick="OnExportCsvAsync">
                                @Texts.DownloadCsv
                            </button>
                        }
                        @if (Expandable)
                        {
                            <button type="button"
                                    class="inline-flex h-7 items-center rounded-(--klyroo-radius) px-2 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted) hover:text-(--klyroo-text)"
                                    aria-expanded="@(_expanded ? "true" : "false")"
                                    data-slot="dashboard-card-expand"
                                    @onclick="@(() => _expanded = !_expanded)">
                                @(_expanded ? Texts.Collapse : Texts.Expand)
                            </button>
                        }
                    }
                </div>
            </header>
        }

        @* Drill-down filter chips *@
        @if (Filters is { Count: > 0 })
        {
            var activeFilters = Filters.Where(f => f.Changed && f.Enabled).ToList();
            @if (activeFilters.Count > 0)
            {
                <div class="flex flex-wrap items-center gap-1.5 px-4 pt-2" data-slot="dashboard-card-chips">
                    @foreach (var f in activeFilters)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-(--klyroo-bg-muted) px-2.5 py-0.5 text-xs font-medium text-(--klyroo-text)"
                              data-slot="dashboard-card-chip">
                            <span>@f.Label: @f.Display</span>
                            <button type="button"
                                    class="inline-flex size-4 items-center justify-center rounded-full text-(--klyroo-text-muted) hover:text-(--klyroo-text)"
                                    aria-label="@Texts.RemoveFilter(f.Label)"
                                    @onclick="f.Reset">✕</button>
                        </span>
                    }
                </div>
            }
        }

        @* Phase body *@
        <div class="flex flex-1 flex-col justify-between gap-3 p-4" data-slot="dashboard-card-body">
            @switch (Phase)
            {
                case DashboardBlockPhase.Idle:
                case DashboardBlockPhase.Loading:
                    <div class="flex flex-col gap-2.5" data-slot="dashboard-skeleton" data-kind="@Skeleton.ToString().ToLowerInvariant()">
                        @if (Skeleton == DashboardSkeletonKind.Stat)
                        {
                            <KlySkeleton Class="h-8 w-28" />
                            <KlySkeleton Class="h-4 w-20" />
                        }
                        else if (Skeleton == DashboardSkeletonKind.Bars || Skeleton == DashboardSkeletonKind.Lines)
                        {
                            <div class="flex h-32 items-end gap-2">
                                <KlySkeleton Class="h-1/2 flex-1" />
                                <KlySkeleton Class="h-3/4 flex-1" />
                                <KlySkeleton Class="h-2/3 flex-1" />
                                <KlySkeleton Class="h-full flex-1" />
                            </div>
                        }
                        else if (Skeleton == DashboardSkeletonKind.Paired)
                        {
                            <div class="flex h-32 items-end gap-4">
                                <div class="flex h-full flex-1 items-end gap-1" data-slot="dashboard-skeleton-pair">
                                    <KlySkeleton Class="h-2/3 flex-1" />
                                    <KlySkeleton Class="h-1/2 flex-1" />
                                </div>
                                <div class="flex h-full flex-1 items-end gap-1" data-slot="dashboard-skeleton-pair">
                                    <KlySkeleton Class="h-full flex-1" />
                                    <KlySkeleton Class="h-3/4 flex-1" />
                                </div>
                                <div class="flex h-full flex-1 items-end gap-1" data-slot="dashboard-skeleton-pair">
                                    <KlySkeleton Class="h-1/2 flex-1" />
                                    <KlySkeleton Class="h-2/3 flex-1" />
                                </div>
                            </div>
                        }
                        else if (Skeleton == DashboardSkeletonKind.Stack)
                        {
                            <div class="flex h-4 w-full gap-px" data-slot="dashboard-skeleton-stack">
                                <KlySkeleton Class="h-full w-1/2" />
                                <KlySkeleton Class="h-full w-1/4" />
                                <KlySkeleton Class="h-full w-1/6" />
                            </div>
                            <div class="flex h-4 w-full gap-px" data-slot="dashboard-skeleton-stack">
                                <KlySkeleton Class="h-full w-2/5" />
                                <KlySkeleton Class="h-full w-1/3" />
                                <KlySkeleton Class="h-full w-1/5" />
                            </div>
                            <div class="flex h-4 w-full gap-px" data-slot="dashboard-skeleton-stack">
                                <KlySkeleton Class="h-full w-1/3" />
                                <KlySkeleton Class="h-full w-1/3" />
                                <KlySkeleton Class="h-full w-1/4" />
                            </div>
                        }
                        else
                        {
                            <KlySkeleton Class="h-4 w-3/4" />
                            <KlySkeleton Class="h-4 w-full" />
                            <KlySkeleton Class="h-4 w-2/3" />
                        }
                    </div>
                    break;

                case DashboardBlockPhase.Error:
                    <div class="flex flex-col items-start gap-2 rounded-(--klyroo-radius) border border-(--klyroo-error)/30 bg-(--klyroo-error)/10 p-3 text-xs"
                         role="alert" data-slot="dashboard-error">
                        <p class="m-0 font-semibold text-(--klyroo-error-text)">@Texts.ErrorTitle</p>
                        <p class="m-0 text-(--klyroo-text-muted)">@(Source?.Error ?? Texts.ErrorMessage)</p>
                        @if (Source is not null)
                        {
                            <button type="button"
                                    class="rounded-(--klyroo-radius) bg-(--klyroo-bg) px-2.5 py-1 font-semibold text-(--klyroo-text-highlighted) shadow-2xs hover:bg-(--klyroo-bg-muted)"
                                    data-slot="dashboard-retry"
                                    @onclick="Source.RefreshAsync">
                                @Texts.Retry
                            </button>
                        }
                    </div>
                    break;

                case DashboardBlockPhase.Empty:
                    <div class="flex flex-col items-center justify-center gap-1 py-6 text-center text-xs text-(--klyroo-text-muted)" data-slot="dashboard-empty">
                        <p class="m-0 font-semibold text-(--klyroo-text-highlighted)">@(EmptyTitle ?? Texts.NoData)</p>
                        @if (!string.IsNullOrEmpty(EmptyDescription))
                        {
                            <p class="m-0">@EmptyDescription</p>
                        }
                    </div>
                    break;

                case DashboardBlockPhase.Content:
                    @if (_showingTable && Tabulate is not null)
                    {
                        var table = Tabulate();
                        <div class="overflow-x-auto" data-slot="dashboard-data-table">
                            <table class="min-w-full text-xs">
                                <thead class="border-b border-(--klyroo-border) font-semibold text-(--klyroo-text-muted)">
                                    <tr>
                                        @foreach (var col in table.Columns)
                                        {
                                            <th scope="col" class="px-2.5 py-1.5 @(col.Numeric ? "text-end" : "text-start")">@col.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-(--klyroo-border)">
                                    @foreach (var row in table.Rows)
                                    {
                                        <tr>
                                            @foreach (var col in table.Columns)
                                            {
                                                row.TryGetValue(col.Key, out var val);
                                                <td class="px-2.5 py-1.5 @(col.Numeric ? "text-end tabular-nums" : "text-start")">@(val ?? DashboardFormat.MissingValue)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        @ChildContent
                    }
                    break;
            }

            @if (Footer is not null || (EffectiveFreshness && Phase == DashboardBlockPhase.Content && Source?.UpdatedAt is not null))
            {
                <footer class="flex items-center justify-between gap-2 border-t border-(--klyroo-border) pt-2 text-xs text-(--klyroo-text-muted)" data-slot="dashboard-card-footer">
                    @if (Footer is not null)
                    {
                        @Footer
                    }
                    @if (EffectiveFreshness && Phase == DashboardBlockPhase.Content && Source?.UpdatedAt is { } updatedAt)
                    {
                        <time datetime="@updatedAt.ToString("O")" data-slot="dashboard-card-freshness">
                            @Texts.Updated(DashboardFormat.FormatRelativeTime(updatedAt, null, Texts.RelativeTime))
                        </time>
                    }
                </footer>
            }
        </div>
    </section>
}

@code {
    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    private bool _showingTable;
    private bool _expanded;

    [CascadingParameter] private KlyDashboardGrid? ParentGrid { get; set; }

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately. The card activates a Deferred source on its first render, and on every render calls <see cref="IDashboardSource.ActivateAsync"/> on a disabled source, which loads it once its <c>enabled</c> predicate returns <see langword="true"/>.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 12.</summary>
    [Parameter] public int Span { get; set; } = 12;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the empty state instead of the content once the source is ready.</summary>
    [Parameter] public bool IsEmpty { get; set; }
    /// <summary>The title of the empty state. Defaults to the <c>NoData</c> text of the locale (<c>No data for this period</c> in English).</summary>
    [Parameter] public string? EmptyTitle { get; set; }
    /// <summary>A line of text under the title of the empty state.</summary>
    [Parameter] public string? EmptyDescription { get; set; }
    /// <summary>The shape of the loading skeleton. <c>Stat</c>, <c>Bars</c>, <c>Lines</c>, <c>Paired</c> and <c>Stack</c> have their own shape, the other kinds render three lines.</summary>
    [Parameter] public DashboardSkeletonKind Skeleton { get; set; } = DashboardSkeletonKind.Rows;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }
    /// <summary>Shows the View as table button in the menu. It needs <see cref="Tabulate"/>. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ViewAsTable { get; set; } = true;
    /// <summary>Shows the Expand button in the menu, which enlarges the card over the page. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Expandable { get; set; } = true;
    /// <summary>Returns the content of the block as a table. It enables the View as table and Download CSV buttons.</summary>
    [Parameter] public Func<DashboardDataTable>? Tabulate { get; set; }
    /// <summary>Filters whose non-default selection is shown as removable chips under the header.</summary>
    [Parameter] public IReadOnlyList<DashboardFilterControl>? Filters { get; set; }
    /// <summary>Receives the CSV text when the user clicks Download CSV, instead of the browser download the card starts by default. Use it to save the file yourself, for example in a .NET MAUI app where the web view cannot download. Name the file with <see cref="DashboardFormat.ResolveFileName"/>.</summary>
    [Parameter] public EventCallback<string> OnCsvExported { get; set; }
    /// <summary>Content placed in the header, before the menu buttons.</summary>
    [Parameter] public RenderFragment? HeaderRight { get; set; }
    /// <summary>Content placed in the footer, before the freshness text.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>The content of the block, rendered once the source is ready and not empty.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool EffectiveMenu => Menu ?? ParentGrid?.Menu ?? false;
    private bool EffectiveFreshness => Freshness ?? ParentGrid?.Freshness ?? false;

    /// <summary>The phase the card is in, derived from the state of <see cref="Source"/>: <c>Idle</c> and <c>Loading</c> show the skeleton, <c>Error</c> the message, otherwise <c>Empty</c> or <c>Content</c>. Without a source it is <c>Content</c>, or <c>Empty</c> when <see cref="IsEmpty"/> is set.</summary>
    public DashboardBlockPhase Phase
    {
        get
        {
            if (Source is null) return IsEmpty ? DashboardBlockPhase.Empty : DashboardBlockPhase.Content;
            return Source.State switch
            {
                DashboardResourceState.Disabled or DashboardResourceState.Idle => DashboardBlockPhase.Idle,
                DashboardResourceState.Loading => DashboardBlockPhase.Loading,
                DashboardResourceState.Error => DashboardBlockPhase.Error,
                _ => IsEmpty ? DashboardBlockPhase.Empty : DashboardBlockPhase.Content,
            };
        }
    }

    private string SpanStyle
    {
        get
        {
            var span = Math.Clamp(Span, 1, ParentGrid?.EffectiveColumns ?? 12);
            return $"grid-column: span {span} / span {span}";
        }
    }

    private string RootClass
    {
        get
        {
            var isPanel = string.Equals(ParentGrid?.Variant, "panels", StringComparison.OrdinalIgnoreCase);
            var surface = !Card ? ""
                : isPanel ? "bg-(--klyroo-bg)"
                : "rounded-(--klyroo-radius-md) border border-(--klyroo-border) bg-(--klyroo-bg) shadow-2xs";
            var expandCls = _expanded ? "fixed inset-4 z-50 overflow-auto shadow-2xl" : "relative flex min-w-0 flex-col overflow-hidden";
            return $"{expandCls} {surface} {Class}".Trim();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // A Deferred source loads on the first render of its card. A disabled source is asked again on every render, so it loads
        // as soon as its enabled predicate turns true; it raises Changed only when its state changes, so this cannot loop.
        if (Source is { Stage: DashboardQueryStage.Deferred, Active: false } or { State: DashboardResourceState.Disabled })
        {
            await Source.ActivateAsync();
        }
    }

    private async Task OnExportCsvAsync()
    {
        if (Tabulate is null) return;
        var csv = DashboardFormat.ExportCsv(Tabulate(), FormatCulture);
        if (OnCsvExported.HasDelegate)
        {
            await OnCsvExported.InvokeAsync(csv);
            return;
        }
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Klyroo.Dashboard/klyroo-dashboard.js");
        await module.InvokeVoidAsync("downloadText", DashboardFormat.ResolveFileName(Title), csv, "text/csv;charset=utf-8");
    }
}
