@namespace Klyroo.Dashboard
@using System.Globalization
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 Skeleton="DashboardSkeletonKind.Gauge" Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="@(IsBar ? "flex w-full flex-col gap-2 py-2" : "flex flex-col items-center justify-center gap-2 py-2")"
         role="meter"
         aria-label="@(Title ?? Texts.Gauge)"
         aria-valuemin="@Min.ToString("0.##", CultureInfo.InvariantCulture)"
         aria-valuemax="@Max.ToString("0.##", CultureInfo.InvariantCulture)"
         aria-valuenow="@(FiniteValue is { } now ? Math.Clamp(now, Math.Min(Min, Max), Math.Max(Min, Max)).ToString("0.##", CultureInfo.InvariantCulture) : Min.ToString("0.##", CultureInfo.InvariantCulture))"
         aria-valuetext="@FormattedValue"
         data-slot="dashboard-gauge"
         data-variant="@(IsBar ? "bar" : "ring")">
        @if (IsBar)
        {
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="text-xl font-bold tabular-nums text-(--klyroo-text-highlighted)" data-slot="gauge-value">@FormattedValue</span>
                @if (!string.IsNullOrEmpty(Caption))
                {
                    <span class="text-xs text-(--klyroo-text-muted)" data-slot="gauge-caption">@Caption</span>
                }
            </div>
            <div class="relative h-2.5 w-full rounded-full bg-(--klyroo-bg-muted)" data-slot="gauge-bar" aria-hidden="true">
                <div class="h-full rounded-full bg-(--klyroo-primary) transition-all"
                     style="@($"width:{(Share * 100).ToString("0.##", CultureInfo.InvariantCulture)}%")"
                     data-slot="gauge-bar-fill"></div>
                @if (TargetShare is { } targetShare)
                {
                    <span class="absolute -top-1 -bottom-1 w-0.5 rounded-full bg-(--klyroo-text-highlighted)"
                          style="@($"left:calc({(targetShare * 100).ToString("0.##", CultureInfo.InvariantCulture)}% - 1px)")"
                          data-slot="gauge-target-marker"></span>
                }
            </div>
            <div class="flex items-center justify-between text-[11px] tabular-nums text-(--klyroo-text-muted)" data-slot="gauge-scale">
                <span>@DashboardFormat.Format(Min, Format, FormatCulture)</span>
                <span>@DashboardFormat.Format(Max, Format, FormatCulture)</span>
            </div>
        }
        else
        {
            <div class="relative flex items-center justify-center" style="width:140px;height:140px">
                <svg viewBox="0 0 100 100" class="size-full -rotate-90 overflow-visible" aria-hidden="true">
                    <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="8" class="text-(--klyroo-bg-muted)" />
                    @* A share of zero draws nothing: a round cap on an empty arc would still leave a dot. *@
                    @if (Share > 0)
                    {
                        <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="8"
                                stroke-linecap="round"
                                stroke-dasharray="263.89"
                                stroke-dashoffset="@DashOffset.ToString("0.##", CultureInfo.InvariantCulture)"
                                class="text-(--klyroo-primary) transition-all"
                                data-slot="gauge-ring-fill" />
                    }
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                    <span class="text-xl font-bold tabular-nums text-(--klyroo-text-highlighted)" data-slot="gauge-value">@FormattedValue</span>
                    @if (!string.IsNullOrEmpty(Caption))
                    {
                        <span class="text-xs text-(--klyroo-text-muted)" data-slot="gauge-caption">@Caption</span>
                    }
                </div>
            </div>
        }
        @if (Target.HasValue)
        {
            <span class="text-xs text-(--klyroo-text-muted)" data-slot="gauge-target">
                @Texts.Target(DashboardFormat.Format(Target, Format, FormatCulture))
            </span>
        }
    </div>
</KlyDashboardCard>

@code {
    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The current value.</summary>
    [Parameter] public double? Value { get; set; }
    /// <summary>The value at which the gauge is empty. Defaults to 0.</summary>
    [Parameter] public double Min { get; set; }
    /// <summary>The value at which the gauge is full. Defaults to 100.</summary>
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>A target shown as text under the gauge, and as a marker on the bar of the <c>bar</c> variant.</summary>
    [Parameter] public double? Target { get; set; }
    /// <summary>How the value and the target are formatted.</summary>
    [Parameter] public DashboardFormatPreset Format { get; set; } = DashboardFormatPreset.Number;
    /// <summary>A line of text under the value inside the ring, or next to the value in the <c>bar</c> variant.</summary>
    [Parameter] public string? Caption { get; set; }
    /// <summary><c>ring</c> (the default) draws a circular gauge with the value in the middle. <c>bar</c> draws a horizontal meter with the value above it, the minimum and maximum under it and a marker at <see cref="Target"/>. Any other value, such as the former default <c>arc</c>, draws the ring. The variant drawn is exposed as <c>data-variant</c>.</summary>
    [Parameter] public string Variant { get; set; } = "ring";
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 4.</summary>
    [Parameter] public int Span { get; set; } = 4;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    /// <summary>The filled fraction of the ring, from 0 to 1: <c>(Value - Min) / (Max - Min)</c>, clamped. 0 when <see cref="Value"/> is <see langword="null"/>, NaN or infinite, or <see cref="Max"/> is not above <see cref="Min"/>.</summary>
    public double Share
    {
        get
        {
            var span = Max - Min;
            if (span <= 0 || Value is not { } value || !double.IsFinite(value)) return 0;
            return Math.Clamp((value - Min) / span, 0, 1);
        }
    }

    private bool IsBar => string.Equals(Variant, "bar", StringComparison.OrdinalIgnoreCase);

    private double? TargetShare
    {
        get
        {
            var span = Max - Min;
            if (span <= 0 || Target is not { } target || double.IsNaN(target)) return null;
            return Math.Clamp((target - Min) / span, 0, 1);
        }
    }

    private double DashOffset => 263.89 * (1.0 - Share);
    // NaN or infinity reads as no value, so nothing renders "NaN".
    private double? FiniteValue => Value is { } v && double.IsFinite(v) ? v : null;

    private string FormattedValue => DashboardFormat.Format(FiniteValue, Format, FormatCulture);

    private DashboardDataTable BuildDataTable()
    {
        var cols = new List<DashboardDataColumn>
        {
            new("label", Texts.ColumnLabel),
            new("value", Texts.ColumnValue, Numeric: true),
            new("min", Texts.ColumnMinimum, Numeric: true),
            new("max", Texts.ColumnMaximum, Numeric: true),
        };
        var row = new Dictionary<string, string?>
        {
            ["label"] = Title ?? Texts.Gauge,
            ["value"] = DashboardFormat.FormatInvariant(FiniteValue),
            ["min"] = DashboardFormat.FormatInvariant(Min),
            ["max"] = DashboardFormat.FormatInvariant(Max),
        };
        if (Target.HasValue)
        {
            cols.Add(new("target", Texts.ColumnTarget, Numeric: true));
            row["target"] = DashboardFormat.FormatInvariant(Target);
        }
        return new DashboardDataTable(cols, [row]);
    }
}
