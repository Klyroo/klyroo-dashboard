@namespace Klyroo.Dashboard
@inherits KlyComponentBase

<KlyDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 IsEmpty="@(Items is not { Count: > 0 })" Skeleton="DashboardSkeletonKind.Rows"
                 Menu="@Menu" Freshness="@Freshness" Tabulate="BuildDataTable" Class="@Class">
    <div class="divide-y divide-(--klyroo-border)" data-slot="dashboard-list">
        @if (Items is { Count: > 0 })
        {
            var visible = Limit is > 0 ? Items.Take(Limit.Value).ToList() : Items;
            @foreach (var item in visible)
            {
                var current = item;
                var clickable = OnRowClick.HasDelegate;
                @* The whole row takes a click of the pointer; the button on its label is what the keyboard and a screen reader reach. *@
                <div class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0 @(clickable ? "cursor-pointer hover:bg-(--klyroo-bg-muted)/50" : null)"
                     data-slot="dashboard-list-row" data-selected="@(item.Selected ? "true" : null)"
                     @onclick="RowClick(current)">
                    <div class="flex min-w-0 items-center gap-2.5">
                        @if (!string.IsNullOrEmpty(item.LeadingText))
                        {
                            <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-(--klyroo-bg-muted) text-xs font-semibold text-(--klyroo-text-highlighted)"
                                  data-slot="dashboard-list-leading">@item.LeadingText</span>
                        }
                        <div class="flex min-w-0 flex-col">
                            @if (!string.IsNullOrEmpty(item.Href))
                            {
                                <a href="@item.Href" class="truncate text-xs font-semibold text-(--klyroo-text-highlighted) hover:underline">@item.Label</a>
                            }
                            else if (clickable)
                            {
                                <button type="button"
                                        class="truncate rounded-(--klyroo-radius) text-start text-xs font-semibold text-(--klyroo-text-highlighted) hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--klyroo-primary-text)"
                                        aria-pressed="@(item.Selected ? "true" : "false")"
                                        data-slot="dashboard-list-row-button"
                                        @onclick="@(() => OnRowClick.InvokeAsync(current))"
                                        @onclick:stopPropagation="true">@item.Label</button>
                            }
                            else
                            {
                                <span class="truncate text-xs font-semibold text-(--klyroo-text-highlighted)">@item.Label</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <span class="truncate text-[11px] text-(--klyroo-text-muted)">@item.Description</span>
                            }
                        </div>
                    </div>

                    <div class="flex shrink-0 items-center gap-2 text-xs tabular-nums">
                        @if (item.Percent is { } pct)
                        {
                            <span class="text-(--klyroo-text-muted)" data-slot="dashboard-list-percent">@DashboardFormat.Format(pct, DashboardFormatPreset.Percent, FormatCulture)</span>
                        }
                        @if (item.Delta is { } delta)
                        {
                            <span class="font-semibold @(DashboardDelta.IsZero(delta) ? "text-(--klyroo-text-muted)" : delta > 0 ? "text-(--klyroo-success-text)" : "text-(--klyroo-error-text)")" data-slot="dashboard-list-delta">
                                @DashboardFormat.Format(delta, DashboardFormatPreset.Delta, FormatCulture)
                            </span>
                        }
                        @if (item.Value.HasValue)
                        {
                            <span class="font-semibold text-(--klyroo-text-highlighted)" data-slot="dashboard-list-value">
                                @DashboardFormat.Format(item.Value, Format, FormatCulture)
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</KlyDashboardCard>

@code {
    private DashboardTexts Texts => Options.Extension<KlyrooDashboardOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The resource whose state drives the block: a skeleton while it loads, an error message with a retry button, then the content. The block does not read <c>Data</c> from it, so pass the data through the other parameters. Without a source the content renders immediately.</summary>
    [Parameter] public IDashboardSource? Source { get; set; }
    /// <summary>The heading of the block.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>A secondary line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The rows, in display order.</summary>
    [Parameter] public IReadOnlyList<DashboardListItem>? Items { get; set; }
    /// <summary>How the row values are formatted.</summary>
    [Parameter] public DashboardFormatPreset Format { get; set; } = DashboardFormatPreset.Number;
    /// <summary>Called with the row when the user picks it. The label of each row without an <c>Href</c> is then a button, so the choice works with the keyboard and with a screen reader, <c>aria-pressed</c> follows <c>Selected</c>, and a click anywhere on the row does the same for the pointer. A row with an <c>Href</c> keeps its link and does not raise this event. Use it to drill down, for example by setting a filter of the <c>DashboardController</c>.</summary>
    [Parameter] public EventCallback<DashboardListItem> OnRowClick { get; set; }
    /// <summary>The maximum number of rows shown. The table view and the CSV export hold the same rows.</summary>
    [Parameter] public int? Limit { get; set; }
    /// <summary>Width of the block in columns of the grid, clamped between 1 and the <c>Columns</c> of the enclosing <c>KlyDashboardGrid</c> (12 outside a grid). Defaults to 6.</summary>
    [Parameter] public int Span { get; set; } = 6;
    /// <summary>Whether the block draws its own surface (border, background and shadow; only the background in a <c>panels</c> grid). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Card { get; set; } = true;
    /// <summary>Shows the View as table, Download CSV and Expand buttons in the header once the content is displayed. Download CSV saves the block's table as a CSV file named after the title. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Menu</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Menu { get; set; }
    /// <summary>Shows an <c>Updated</c> footer built from <c>Source.UpdatedAt</c>. When <see langword="null"/>, the value of the enclosing <c>KlyDashboardGrid.Freshness</c> applies, or <see langword="false"/> outside a grid.</summary>
    [Parameter] public bool? Freshness { get; set; }

    // Without a handler, or on a row with a link, the row gets no click binding at all.
    private EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> RowClick(DashboardListItem item) =>
        OnRowClick.HasDelegate && string.IsNullOrEmpty(item.Href) ? EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => OnRowClick.InvokeAsync(item)) : default;

    private DashboardDataTable BuildDataTable()
    {
        var items = Items ?? [];
        var visible = (Limit is > 0 ? items.Take(Limit.Value) : items).ToList();
        var cols = new List<DashboardDataColumn> { new("label", Texts.ColumnLabel) };
        if (visible.Any(i => !string.IsNullOrEmpty(i.Description))) cols.Add(new("description", Texts.ColumnDescription));
        if (visible.Any(i => i.Percent.HasValue)) cols.Add(new("percent", Texts.ColumnPercent, Numeric: true));
        if (visible.Any(i => i.Delta.HasValue)) cols.Add(new("change", Texts.ColumnChangePercent, Numeric: true));
        cols.Add(new("value", Texts.ColumnValue, Numeric: true));
        var rows = visible.Select(i => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
        {
            ["label"] = i.Label,
            ["description"] = i.Description,
            ["percent"] = DashboardFormat.FormatInvariant(i.Percent),
            ["change"] = DashboardFormat.FormatInvariant(i.Delta),
            ["value"] = DashboardFormat.FormatInvariant(i.Value),
        }).ToList();
        return new DashboardDataTable(cols, rows);
    }
}
